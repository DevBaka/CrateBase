<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Native libvlc-Binaries: unter Linux wird die System-libvlc verwendet (siehe README der
         Zielplattform), unter Windows/Mac bündeln diese Pakete die native Runtime mit. -->
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="'$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cratebase.Core\Cratebase.Core.csproj" />
    <ProjectReference Include="..\Cratebase.Server\Cratebase.Server.csproj" />
    <ProjectReference Include="..\Cratebase.Data\Cratebase.Data.csproj" />
    <ProjectReference Include="..\Cratebase.Scanning\Cratebase.Scanning.csproj" />
    <ProjectReference Include="..\Cratebase.Tagging\Cratebase.Tagging.csproj" />
    <ProjectReference Include="..\Cratebase.Audio\Cratebase.Audio.csproj" />
    <ProjectReference Include="..\Cratebase.Import\Cratebase.Import.csproj" />
    <ProjectReference Include="..\Cratebase.Analysis\Cratebase.Analysis.csproj" />
  </ItemGroup>
</Project>
