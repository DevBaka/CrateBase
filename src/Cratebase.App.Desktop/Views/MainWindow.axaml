<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cratebase.App.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Cratebase.App.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cratebase" Width="1200" Height="760">

    <DockPanel>
        <!-- Kopfleiste: Bibliothek erweitern + Suche -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="12,12,12,6">
            <Button Grid.Column="0" Content="Ordner hinzufügen…" Click="OnAddFolderClick" IsEnabled="{Binding !IsScanning}" />
            <TextBox Grid.Column="1" Margin="12,0" PlaceholderText="Suche (Titel, Artist, Album)…" Text="{Binding SearchText}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}" />
        </Grid>

        <!-- Transportleiste unten -->
        <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemBaseLowColor}">
            <Grid ColumnDefinitions="220,Auto,Auto,Auto,*,Auto,120">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NowPlayingArtist}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1" Content="⏮" Margin="12,0,4,0" Command="{Binding PlayPreviousCommand}" />
                <Button Grid.Column="2" Content="⏯" Margin="4,0" FontSize="16" Command="{Binding PlayPauseCommand}" />
                <Button Grid.Column="3" Content="⏭" Margin="4,0" Command="{Binding PlayNextCommand}" />

                <Grid Grid.Column="4" ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Width="44" Text="{Binding PositionSeconds, StringFormat={}{0:0}}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Width="44" Text="{Binding DurationSeconds, StringFormat={}{0:0}}" />
                </Grid>

                <TextBlock Grid.Column="5" Text="🔊" VerticalAlignment="Center" Margin="4,0" />
                <Slider Grid.Column="6" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Hauptbereich: Playlist-Baum links, Track-Liste rechts -->
        <Grid ColumnDefinitions="280,*">
            <DockPanel Grid.Column="0" Margin="12,0,6,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
                    <Button Content="+ Ordner" Command="{Binding CreateFolderCommand}" />
                    <Button Content="+ Playlist" Command="{Binding CreatePlaylistCommand}" />
                    <Button Content="Löschen" Command="{Binding DeleteSelectedNodeCommand}" />
                </StackPanel>

                <TreeView ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="6,0,12,12">
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <Run Text="{Binding LoadedCount}" /><Run Text=" von " /><Run Text="{Binding TotalCount}" /><Run Text=" geladen" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="Mehr laden" Margin="0,0,8,0"
                            Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
                    <Button Grid.Column="2" Content="Zu Playlist hinzufügen" Command="{Binding AddSelectedTrackToPlaylistCommand}" />
                </Grid>

                <DataGrid Name="TrackGrid"
                          ItemsSource="{Binding Tracks}"
                          SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          DoubleTapped="OnTrackGridDoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Titel" Binding="{Binding DisplayTitle}" Width="2*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding DisplayArtist}" Width="1.5*" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="1.5*" />
                        <DataGridTextColumn Header="Genre" Binding="{Binding GenreRaw}" Width="*" />
                        <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="70" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DisplayDuration}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
