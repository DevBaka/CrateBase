<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cratebase.App.Desktop.ViewModels"
        xmlns:conv="using:Cratebase.App.Desktop.Converters"
        xmlns:controls="using:Cratebase.App.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="860"
        x:Class="Cratebase.App.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cratebase" Width="1360" Height="860"
        Background="{StaticResource BgWindowBrush}">

    <Window.Resources>
        <conv:SecondsToTimeStringConverter x:Key="SecondsToTime" />
        <conv:SectionToBackgroundConverter x:Key="SectionBg" />
        <conv:SectionToForegroundConverter x:Key="SectionFg" />
        <conv:GenreToForegroundConverter x:Key="GenreFg" />
        <conv:GenreToBackgroundConverter x:Key="GenreBg" />
    </Window.Resources>

    <DockPanel>
        <!-- ================= Top-Nav ================= -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="16,10"
              Height="36">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Content="Bibliothek" Command="{Binding GoToSectionCommand}" CommandParameter="Library"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=Library}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=Library}" />
                <Button Content="Set Planner" Command="{Binding GoToSectionCommand}" CommandParameter="Planner"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=Planner}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=Planner}" />
                <Button Content="Analytics" Command="{Binding GoToSectionCommand}" CommandParameter="Analytics"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=Analytics}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=Analytics}" />
                <Button Content="Duplicates" Command="{Binding GoToSectionCommand}" CommandParameter="Duplicates"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=Duplicates}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=Duplicates}" />
                <Button Content="DJ App" Command="{Binding GoToSectionCommand}" CommandParameter="DjApp"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=DjApp}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=DjApp}" />
                <Button Content="Verlauf" Command="{Binding GoToSectionCommand}" CommandParameter="History"
                        BorderThickness="0" Padding="12,7" CornerRadius="8" FontSize="13"
                        Background="{Binding CurrentSection, Converter={StaticResource SectionBg}, ConverterParameter=History}"
                        Foreground="{Binding CurrentSection, Converter={StaticResource SectionFg}, ConverterParameter=History}" />
            </StackPanel>

            <Button Grid.Column="2" Content="⚙ Einstellungen" Margin="0,0,8,0">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="10" Margin="8" MinWidth="280">
                            <TextBlock Text="Schnellzugriffe" FontWeight="Bold" FontSize="13" />
                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                                       Text="Ordner, die im Baum links direkt neben den Playlisten ausklappbar erscheinen (z.B. M:/Musik oder /home/dj/Music)." />
                            <ItemsControl ItemsSource="{Binding QuickAccessFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="×" FontSize="12" Padding="8,2"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveQuickAccessCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Ordner hinzufügen…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnAddQuickAccessClick" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Border Grid.Column="3" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush1}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}" />
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding TotalCount}" /><Run Text=" Tracks in der Sammlung" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Content ================= -->
        <Panel>

            <!-- Bibliothek (funktional) -->
            <Grid ColumnDefinitions="240,*" IsVisible="{Binding IsLibrarySection}">

                <!-- Sidebar: EIN Baum für Bibliothek/Playlisten UND Festplatten/Schnellzugriffe -->
                <DockPanel Grid.Column="0" Margin="12,0,0,12" Background="{StaticResource BgSurfaceBrush}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="10,10,10,8" IsVisible="{Binding IsShowingTrackGrid}">
                        <Button Content="+ Ordner" FontSize="11" Padding="8,5" Command="{Binding CreateFolderCommand}" />
                        <Button Content="+ Playlist" FontSize="11" Padding="8,5" Command="{Binding CreatePlaylistCommand}" />
                        <Button Content="Löschen" FontSize="11" Padding="8,5" Command="{Binding DeleteSelectedNodeCommand}" />
                    </StackPanel>

                    <TreeView ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                              Background="Transparent" Padding="4,0" BorderThickness="0"
                              PointerPressed="OnPlaylistTreePointerPressed" PointerMoved="OnPlaylistTreePointerMoved">
                        <!-- ReflectionBinding statt compiled Binding: der Baum mischt zwei Item-Typen (Playlist- und
                             Dateisystem-Knoten), nur letztere kennen IsExpanded. Eine compilierte Bindung würde bei
                             der falschen Typ-Kombination zur Laufzeit werfen; ReflectionBinding schlägt an
                             Playlist-Zeilen einfach folgenlos fehl (kein IsExpanded dort), statt abzustürzen. -->
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:PlaylistTreeItemViewModel" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Padding="6,5" />
                            </TreeDataTemplate>
                            <TreeDataTemplate DataType="vm:FileSystemNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="6,5">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </DockPanel>

                <!-- Track-/Datei-Bereich + Transportleiste -->
                <DockPanel Grid.Column="1" Margin="0,0,12,12">

                    <!-- Kopfzeile: Ordner/Import-Buttons + Spalten + Unterordner-Schalter + Suche + Status -->
                    <Grid DockPanel.Dock="Top" Margin="14,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <!-- Feste Mindestbreite statt reinem "*": bei vielen Buttons links soll die Suche
                                 nicht auf (fast) 0 zusammengequetscht werden - dann eher die Statusmeldung rechts
                                 kürzer anzeigen (die hat schon TextTrimming+MaxWidth). -->
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Ordner hinzufügen…" Click="OnAddFolderClick" IsEnabled="{Binding !IsScanning}" />
                        <Button Grid.Column="1" Content="Traktor-Collection importieren…" Margin="6,0,0,0" Click="OnImportTraktorClick" IsEnabled="{Binding !IsScanning}" />
                        <!-- Spalten-Auswahl und Edit-Modus gelten für Bibliothek UND Datei-Browser gleichermaßen
                             (beide DataGrids teilen sich Spaltenlayout und SelectedTrack, s. ARCHITECTURE.md 14.3) -
                             deshalb keine IsShowingTrackGrid-Einschränkung wie bei Suche/Fußzeile, die nur für die
                             Bibliotheksliste sinnvoll sind. -->
                        <Button Grid.Column="2" Content="Spalten ▾" Margin="6,0,0,0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="9" Margin="6" MinWidth="150">
                                        <TextBlock Text="Sichtbare Spalten" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                        <CheckBox Content="Album" FontSize="12.5" IsChecked="{Binding ShowAlbumColumn}" />
                                        <CheckBox Content="Genre" FontSize="12.5" IsChecked="{Binding ShowGenreColumn}" />
                                        <CheckBox Content="Sub-Genre" FontSize="12.5" IsChecked="{Binding ShowSubGenreColumn}" />
                                        <CheckBox Content="BPM" FontSize="12.5" IsChecked="{Binding ShowBpmColumn}" />
                                        <CheckBox Content="Key" FontSize="12.5" IsChecked="{Binding ShowKeyColumn}" />
                                        <CheckBox Content="Dauer" FontSize="12.5" IsChecked="{Binding ShowDurationColumn}" />
                                        <CheckBox Content="Kommentar" FontSize="12.5" IsChecked="{Binding ShowCommentColumn}" />
                                        <CheckBox Content="Kommentar 2" FontSize="12.5" IsChecked="{Binding ShowComment2Column}" />
                                        <CheckBox Content="Farbe" FontSize="12.5" IsChecked="{Binding ShowColorColumn}" />
                                        <CheckBox Content="Pfad" FontSize="12.5" IsChecked="{Binding ShowPathColumn}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton Grid.Column="3" Content="✎ Edit-Modus" Margin="6,0,0,0"
                                      IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                                      ToolTip.Tip="Metadaten (Genre, Sub-Genre, Kommentare, Farbe, Titel, Artist, BPM, Key …) direkt in der App bearbeiten." />
                        <ToggleButton Grid.Column="4" Content="★ Favoriten" Margin="6,0,0,0"
                                      IsChecked="{Binding IsFavoritesMode, Mode=TwoWay}"
                                      ToolTip.Tip="Nummerierte Playlist-Favoriten-Slots, gruppiert in Profilen (z.B. ein Profil je Genre) - schneller Zugriff ohne im Playlist-Baum zu suchen." />
                        <CheckBox Grid.Column="5" Content="Unterordner einbeziehen" FontSize="11.5" Margin="10,0,0,0"
                                  VerticalAlignment="Center" IsChecked="{Binding IncludeSubfolders}"
                                  ToolTip.Tip="Zeigt auch Tracks/Dateien aus verschachtelten Playlisten bzw. Unterordnern, nicht nur die direkten. Gilt pro Ordner und wird sich für diese Sitzung gemerkt - andere Ordner sind davon unabhängig." />
                        <TextBox Grid.Column="6" Margin="12,0" PlaceholderText="Suche (Titel, Artist, Album)…" Text="{Binding SearchText}" IsVisible="{Binding IsShowingTrackGrid}" />
                        <TextBlock Grid.Column="7" VerticalAlignment="Center" MaxWidth="300" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}" />
                    </Grid>

                    <!-- Transportleiste unten: RGB-Waveform statt reinem Fortschritts-Slider -->
                    <Border DockPanel.Dock="Bottom" Padding="18,12" Background="{StaticResource BgSurfaceBrush}"
                            BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush1}">
                        <Grid ColumnDefinitions="200,Auto,Auto,Auto,*,Auto,120">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding NowPlayingArtist}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="⏮" Margin="14,0,4,0" Padding="9,7" Command="{Binding PlayPreviousCommand}" />
                            <Button Grid.Column="2" Content="⏯" Margin="4,0" Padding="9,7" FontSize="15"
                                    Background="{StaticResource AccentGreenBrush}" Foreground="{StaticResource BgWindowBrush}"
                                    Command="{Binding PlayPauseCommand}" />
                            <Button Grid.Column="3" Content="⏭" Margin="4,0" Padding="9,7" Command="{Binding PlayNextCommand}" />

                            <Grid Grid.Column="4" ColumnDefinitions="Auto,*,Auto" Margin="18,0" VerticalAlignment="Center" Height="64">
                                <TextBlock Grid.Column="0" Width="42" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" Text="{Binding PositionSeconds, Converter={StaticResource SecondsToTime}}" />
                                <controls:WaveformView Grid.Column="1" Margin="10,0"
                                                        Waveform="{Binding CurrentWaveform}" Progress="{Binding ProgressFraction}"
                                                        SeekCommand="{Binding SeekToFractionCommand}" />
                                <TextBlock Grid.Column="2" Width="42" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Text="{Binding DurationSeconds, Converter={StaticResource SecondsToTime}}" />
                            </Grid>

                            <TextBlock Grid.Column="5" Text="🔊" VerticalAlignment="Center" Margin="4,0" FontSize="13" />
                            <Slider Grid.Column="6" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Favoriten-Leiste: Playlist-Favoriten/Profile-Manager (Traktor-artige nummerierte
                         Slots, aber frei wählbare Anzahl statt fester 12, gruppiert in wechselbaren Profilen -
                         z.B. "Hardstyle" vs. "House" mit komplett unterschiedlicher Slot-Belegung). Wie beim
                         Edit-Modus per Toggle ein-/ausblendbar, direkt über der Transportleiste (Nutzer-Feedback:
                         "dort wo du auch edit modus hingepackt hast... oberhalb von dem player modul"). -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsFavoritesMode}" Padding="18,12"
                            Background="{StaticResource BgSurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush1}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Profil" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding FavoriteProfiles}" SelectedItem="{Binding SelectedFavoriteProfile, Mode=TwoWay}"
                                          PlaceholderText="Kein Profil">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="💾 Speichern" Command="{Binding SaveFavoriteProfileCommand}"
                                        IsEnabled="{Binding SelectedFavoriteProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Grid.Column="3" Content="Löschen" Command="{Binding DeleteFavoriteProfileCommand}"
                                        IsEnabled="{Binding SelectedFavoriteProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBox Grid.Column="5" Width="170" PlaceholderText="Neuer Profilname…" Text="{Binding NewFavoriteProfileName, Mode=TwoWay}" />
                                <Button Grid.Column="6" Content="+ Als neues Profil speichern" Command="{Binding SaveFavoriteProfileAsCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Slots:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="60" FormatString="0"
                                               Value="{Binding FavoriteSlotCount, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                                           Text="Playlist aus dem Baum links auf einen Slot ziehen (oder Playlist auswählen + Rechtsklick auf einen Slot). Track aus der Liste auf einen belegten Slot ziehen fügt ihn dort hinzu (oder „+“-Button). Klick auf einen belegten Slot springt dorthin." />
                            </Grid>

                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FavoriteSlots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- $parent[Window] statt $parent[ItemsControl]: Letzteres löst aus dem
                                                 ContextMenu heraus (eigener Popup-Zweig, kein normaler visueller
                                                 Nachfahre der ItemsControl) nicht zuverlässig auf - "Aktuelle
                                                 Playlist hier ablegen" tat dadurch nichts. $parent[Window] ist
                                                 bereits an anderer Stelle (DataGridColumn.IsVisible) bewährt robust
                                                 gegen genau solche "losgelöste Popup/Vorlage"-Fälle. -->
                                            <Border Width="150" Margin="0,0,8,8" Padding="8,6" CornerRadius="6"
                                                    Background="{StaticResource BgChipBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush1}"
                                                    DragDrop.AllowDrop="True"
                                                    DragDrop.DragEnter="OnFavoriteSlotDragEnter" DragDrop.DragOver="OnFavoriteSlotDragOver"
                                                    DragDrop.DragLeave="OnFavoriteSlotDragLeave" DragDrop.Drop="OnFavoriteSlotDrop">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Aktuelle Playlist hier ablegen"
                                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AssignSelectedPlaylistToSlotCommand}"
                                                                  CommandParameter="{Binding Index}" />
                                                        <MenuItem Header="Slot leeren"
                                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ClearFavoriteSlotCommand}"
                                                                  CommandParameter="{Binding Index}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}">
                                                        <Run Text="Slot " /><Run Text="{Binding DisplayNumber}" />
                                                    </TextBlock>
                                                    <Button Grid.Row="0" Grid.Column="1" Content="+" FontSize="11" Padding="6,1" IsVisible="{Binding IsAssigned}"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddSelectedTrackToFavoriteSlotCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Ausgewählten Track hier hinzufügen" />
                                                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Background="Transparent" BorderThickness="0" Padding="0,3,0,0" FontSize="12"
                                                            Content="{Binding DisplayText}"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActivateFavoriteSlotCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Tag-Editor: erscheint zwischen Songliste und Transportleiste, wenn Edit-Modus aktiv ist
                         ("Im Edit mode soll die song liste etwas verkleinert werden...", Nutzer-Feedback). Feste
                         Höhe statt eigener Row-Umschaltlogik - die Songliste sitzt im Panel darüber, das per
                         DockPanel-LastChildFill automatisch schrumpft, sobald dieser Block eingeblendet wird. -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsEditMode}" Padding="18,12"
                            Background="{StaticResource BgSurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush1}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="Metadaten bearbeiten" /><Run Text=" — " /><Run Text="{Binding SelectedTrack.DisplayTitle}" />
                            </TextBlock>

                            <Grid ColumnDefinitions="2*,1.4*,1.4*,0.7*,0.6*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Titel" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBox Text="{Binding EditTitle, Mode=TwoWay}" LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Artist" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBox Text="{Binding EditArtist, Mode=TwoWay}" LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="Album" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBox Text="{Binding EditAlbum, Mode=TwoWay}" LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="BPM" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBox Text="{Binding EditBpmText, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}" LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="3">
                                    <TextBlock Text="Key" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBox Text="{Binding EditKey, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}" LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                            </Grid>

                            <!-- Genre/Sub-Genre/Kommentar/Kommentar 2/Farbe: AutoCompleteBox statt TextBox - schlägt
                                 beim Tippen bereits benutzte Werte vor (Contains-Filter, z.B. "ban" findet "banger"),
                                 auswählbar per Enter oder Mausklick, ohne fertig tippen zu müssen (Nutzer-Feedback).
                                 Neu getippte Werte landen einfach als normaler Feldwert - beim Speichern lädt
                                 LoadEditSuggestionsAsync die Vorschlagsliste neu, der neue Wert taucht dann mit auf. -->
                            <Grid ColumnDefinitions="1.2*,1.2*,1.2*,1.2*,0.8*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Genre" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <AutoCompleteBox Text="{Binding EditGenre, Mode=TwoWay}" ItemsSource="{Binding GenreSuggestions}"
                                                      FilterMode="Contains" MinimumPrefixLength="1" IsTextCompletionEnabled="True"
                                                      LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Sub-Genre" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <AutoCompleteBox Text="{Binding EditSubGenre, Mode=TwoWay}" ItemsSource="{Binding SubGenreSuggestions}"
                                                      FilterMode="Contains" MinimumPrefixLength="1" IsTextCompletionEnabled="True"
                                                      LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="Kommentar" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <AutoCompleteBox Text="{Binding EditComment, Mode=TwoWay}" ItemsSource="{Binding CommentSuggestions}"
                                                      FilterMode="Contains" MinimumPrefixLength="1" IsTextCompletionEnabled="True"
                                                      LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="Kommentar 2" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <AutoCompleteBox Text="{Binding EditComment2, Mode=TwoWay}" ItemsSource="{Binding Comment2Suggestions}"
                                                      FilterMode="Contains" MinimumPrefixLength="1" IsTextCompletionEnabled="True"
                                                      LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="3">
                                    <TextBlock Text="Farbe" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <AutoCompleteBox Text="{Binding EditColorTag, Mode=TwoWay}" ItemsSource="{Binding ColorSuggestions}"
                                                      FilterMode="Contains" MinimumPrefixLength="1" IsTextCompletionEnabled="True"
                                                      LostFocus="OnEditFieldLostFocus" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fußzeile der Liste: geladen / mehr laden / zu Playlist -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="14,6" IsVisible="{Binding IsShowingTrackGrid}">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextFaintBrush}">
                            <Run Text="{Binding LoadedCount}" /><Run Text=" von " /><Run Text="{Binding TotalCount}" /><Run Text=" geladen" />
                        </TextBlock>
                        <Button Grid.Column="1" Content="Mehr laden" Margin="0,0,8,0"
                                Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
                        <Button Grid.Column="2" Content="Zu Playlist hinzufügen" Command="{Binding AddSelectedTrackToPlaylistCommand}" />
                    </Grid>

                    <Panel>
                        <!-- Track-Tabelle -->
                        <DataGrid Name="TrackGrid" Margin="6,0,0,0" IsVisible="{Binding IsShowingTrackGrid}"
                                  ItemsSource="{Binding Tracks}"
                                  SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  DoubleTapped="OnTrackGridDoubleTapped"
                                  PointerPressed="OnTrackGridPointerPressed" PointerMoved="OnTrackGridPointerMoved">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Titel" Binding="{Binding DisplayTitle}" Width="2*" MinWidth="160" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Artist" Binding="{Binding DisplayArtist}" Width="180" MinWidth="90" />
                                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="180" MinWidth="90" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowAlbumColumn}" />
                                <DataGridTemplateColumn Header="Genre" Width="140" MinWidth="90" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowGenreColumn}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding GenreRaw, Converter={StaticResource GenreBg}}"
                                                    CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    IsVisible="{Binding GenreRaw, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding GenreRaw}" FontSize="10.5"
                                                           Foreground="{Binding GenreRaw, Converter={StaticResource GenreFg}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Sub-Genre" Binding="{Binding SubGenre}" Width="120" MinWidth="80"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSubGenreColumn}" />
                                <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="80" MinWidth="56" FontFamily="{StaticResource MonoFont}"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowBpmColumn}" />
                                <DataGridTextColumn Header="Key" Binding="{Binding MusicalKey}" Width="70" MinWidth="48" FontFamily="{StaticResource MonoFont}"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowKeyColumn}" />
                                <DataGridTextColumn Header="Dauer" Binding="{Binding DisplayDuration}" Width="80" MinWidth="56" FontFamily="{StaticResource MonoFont}"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowDurationColumn}" />
                                <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="160" MinWidth="80"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowCommentColumn}" />
                                <DataGridTextColumn Header="Kommentar 2" Binding="{Binding Comment2}" Width="160" MinWidth="80"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowComment2Column}" />
                                <DataGridTextColumn Header="Farbe" Binding="{Binding ColorTag}" Width="90" MinWidth="60"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowColorColumn}" />
                                <DataGridTextColumn Header="Pfad" Binding="{Binding RelativePath}" Width="260" MinWidth="120" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                     IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowPathColumn}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Datei-Browser: was wirklich auf der Platte liegt - dieselben Spalten wie die Bibliothek
                             (gescannte Dateien liefern echte Tracks aus der DB, noch nicht gescannte einen Platzhalter
                             mit nur Dateiname/Pfad, s. ReloadFolderFilesAsync/Track.IsSynthetic), dieselbe SelectedTrack-
                             Bindung, damit Doppelklick, Edit-Modus und die Transportleiste unverändert weiterlaufen. -->
                        <Grid IsVisible="{Binding IsShowingFileList}" Margin="6,0,0,0" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,0,8,10">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding FolderScannedCount}" /><Run Text=" von " /><Run Text="{Binding FolderTotalCount}" /><Run Text=" Dateien in diesem Ordner gescannt" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Diesen Ordner scannen" Command="{Binding ScanSelectedFolderCommand}" IsEnabled="{Binding !IsScanning}" />
                            </Grid>

                            <DataGrid Grid.Row="1" Name="FolderFilesGrid"
                                      ItemsSource="{Binding FolderTracks}"
                                      SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      DoubleTapped="OnTrackGridDoubleTapped"
                                      PointerPressed="OnTrackGridPointerPressed" PointerMoved="OnTrackGridPointerMoved">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Titel" Binding="{Binding DisplayTitle}" Width="2*" MinWidth="160" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding DisplayArtist}" Width="180" MinWidth="90" />
                                    <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="180" MinWidth="90" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowAlbumColumn}" />
                                    <DataGridTemplateColumn Header="Genre" Width="140" MinWidth="90" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowGenreColumn}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding GenreRaw, Converter={StaticResource GenreBg}}"
                                                        CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        IsVisible="{Binding GenreRaw, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Text="{Binding GenreRaw}" FontSize="10.5"
                                                               Foreground="{Binding GenreRaw, Converter={StaticResource GenreFg}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Sub-Genre" Binding="{Binding SubGenre}" Width="120" MinWidth="80"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSubGenreColumn}" />
                                    <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="80" MinWidth="56" FontFamily="{StaticResource MonoFont}"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowBpmColumn}" />
                                    <DataGridTextColumn Header="Key" Binding="{Binding MusicalKey}" Width="70" MinWidth="48" FontFamily="{StaticResource MonoFont}"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowKeyColumn}" />
                                    <DataGridTextColumn Header="Dauer" Binding="{Binding DisplayDuration}" Width="80" MinWidth="56" FontFamily="{StaticResource MonoFont}"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowDurationColumn}" />
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="160" MinWidth="80"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowCommentColumn}" />
                                    <DataGridTextColumn Header="Kommentar 2" Binding="{Binding Comment2}" Width="160" MinWidth="80"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowComment2Column}" />
                                    <DataGridTextColumn Header="Farbe" Binding="{Binding ColorTag}" Width="90" MinWidth="60"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowColorColumn}" />
                                    <DataGridTextColumn Header="Pfad" Binding="{Binding RelativePath}" Width="260" MinWidth="120" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowPathColumn}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Panel>
                </DockPanel>
            </Grid>

            <!-- Platzhalter für Set Planner / Analytics / Duplicates / DJ App / Verlauf -->
            <Grid IsVisible="{Binding !IsLibrarySection}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
                    <TextBlock Text="{Binding PlaceholderSectionTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Kommt in einer späteren Phase – noch nicht gebaut." FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Panel>
    </DockPanel>
</Window>
